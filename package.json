{
  "name": "@rehearsal-db/core",
  "version": "0.1.0-beta.16",
  "private": false,
  "description": "Safely rehearse PostgreSQL and Supabase migrations against sanitized, production-shaped data.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ddupasquier/rehearsal-db.git"
  },
  "bugs": {
    "url": "https://github.com/Ddupasquier/rehearsal-db/issues"
  },
  "homepage": "https://ddupasquier.github.io/rehearsal-db/",
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "bin": {
    "rehearsal": "dist/src/cli/rehearsal.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/configuration.d.mts",
      "import": "./dist/src/index.mjs"
    },
    "./baseline": "./dist/src/baseline/artifact.mjs",
    "./baseline-builder": "./dist/src/baseline/builder.mjs",
    "./diagnostics": "./dist/src/shared/diagnostics.mjs",
    "./migrations": "./dist/src/runtime/migration_history.mjs",
    "./process-environment": "./dist/src/shared/process_environment.mjs",
    "./privacy": "./dist/src/baseline/privacy_engine.mjs",
    "./schema": "./dist/src/baseline/schema_snapshot.mjs",
    "./service-environment": "./dist/src/runtime/service_environment.mjs",
    "./source-access": "./dist/src/source/access.mjs"
  },
  "files": [
    "dist",
    "types",
    "docs/*.md",
    "README.md",
    "BENCHMARKS.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "COMPATIBILITY.md",
    "SUPPORT.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node dist/scripts/install/create_root_config.mjs",
    "prepack": "npm run build",
    "build": "node scripts/build/clean.mjs && tsc --project tsconfig.build.json",
    "docs:build": "node scripts/docs/build.mjs",
    "docs:preview": "node scripts/docs/serve.mjs",
    "test": "npm run build && vitest run",
    "test:unit": "npm run build && vitest run tests/unit",
    "test:integration": "npm run build && vitest run tests/integration tests/contracts",
    "test:docs": "npm run build && vitest run tests/contracts/documentationCommands.test.mjs",
    "test:fixture": "npm run build && node scripts/verification/fixtures/supabase.mjs",
    "test:fixture:postgresql": "npm run build && node scripts/verification/fixtures/postgresql.mjs",
    "test:fixture:dependent": "npm run build && node scripts/verification/fixtures/dependent.mjs",
    "test:fixture:onboarding": "npm run build && node scripts/verification/fixtures/onboarding.mjs",
    "test:fixture:typescript": "npm run build && node scripts/verification/fixtures/typescript.mjs",
    "test:fixture:standalone": "npm run build && node scripts/verification/fixtures/standalone.mjs",
    "test:fixture:privacy": "npm run build && node scripts/verification/fixtures/privacy.mjs",
    "check": "npm run check:syntax && npm run typecheck && npm run test && npm run docs:build && npm run format:check && npm run package:audit",
    "check:syntax": "find scripts tests -type f -name '*.mjs' -exec node --check {} +",
    "typecheck": "npm run build && tsc --project tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:audit": "node scripts/verification/audit_package.mjs"
  },
  "keywords": [
    "postgresql",
    "supabase",
    "migration",
    "testing",
    "database"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "marked": "^18.0.14",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "vitest": "^5.0.2"
  }
}
