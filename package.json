{
  "name": "@rehearsal-db/core",
  "version": "0.1.0-beta.13",
  "private": false,
  "description": "Safely rehearse PostgreSQL and Supabase migrations against sanitized, production-shaped data.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ddupasquier/rehearsal-db.git"
  },
  "bugs": {
    "url": "https://github.com/Ddupasquier/rehearsal-db/issues"
  },
  "homepage": "https://ddupasquier.github.io/rehearsal-db/",
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "bin": {
    "rehearsal": "src/cli/rehearsal.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/project/configuration.d.mts",
      "import": "./src/project/configuration.mjs"
    },
    "./baseline": "./src/baseline/artifact.mjs",
    "./baseline-builder": "./src/baseline/builder.mjs",
    "./diagnostics": "./src/shared/diagnostics.mjs",
    "./migrations": "./src/runtime/migration_history.mjs",
    "./process-environment": "./src/shared/process_environment.mjs",
    "./privacy": "./src/baseline/privacy_engine.mjs",
    "./schema": "./src/baseline/schema_snapshot.mjs",
    "./service-environment": "./src/runtime/service_environment.mjs",
    "./source-access": "./src/source/access.mjs"
  },
  "files": [
    "src",
    "scripts/install/create_root_config.mjs",
    "scripts/runtime/manage_database.mjs",
    "docs/*.md",
    "README.md",
    "BENCHMARKS.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "COMPATIBILITY.md",
    "SUPPORT.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/install/create_root_config.mjs",
    "docs:build": "node scripts/docs/build.mjs",
    "docs:preview": "node scripts/docs/serve.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration tests/contracts",
    "test:docs": "vitest run tests/contracts/documentationCommands.test.mjs",
    "test:fixture": "node scripts/verification/fixtures/supabase.mjs",
    "test:fixture:postgresql": "node scripts/verification/fixtures/postgresql.mjs",
    "test:fixture:dependent": "node scripts/verification/fixtures/dependent.mjs",
    "test:fixture:onboarding": "node scripts/verification/fixtures/onboarding.mjs",
    "test:fixture:standalone": "node scripts/verification/fixtures/standalone.mjs",
    "test:fixture:privacy": "node scripts/verification/fixtures/privacy.mjs",
    "check": "npm run check:syntax && npm run test && npm run docs:build && npm run format:check && npm run package:audit",
    "check:syntax": "find src scripts tests -type f -name '*.mjs' -exec node --check {} +",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:audit": "node scripts/verification/audit_package.mjs"
  },
  "keywords": [
    "postgresql",
    "supabase",
    "migration",
    "testing",
    "database"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "marked": "^18.0.14",
    "prettier": "^3.9.6",
    "vitest": "^5.0.2"
  }
}
